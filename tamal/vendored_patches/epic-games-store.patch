+{
+  lib,
+  stdenv,
+  appimageTools,
+  fetchurl,
+  autoPatchelfHook,
+  wrapGAppsHook3,
+  steam,
+  webkitgtk_4_1,
+  libsoup_3,
+  gtk3,
+  glib,
+  glib-networking,
+  cairo,
+  gdk-pixbuf,
+  libx11,
+  libxi,
+  dbus,
+  libGL,
+  libayatana-appindicator,
+  gsettings-desktop-schemas,
+  gst_all_1,
+}:
+
+let
+  pname = "epic-games-launcher";
+  version = "0.103.0";
+  # Build identifier that upstream appends to the version in the download path
+  build = "g66c2498";
+
+  src = fetchurl {
+    url = "https://content-download-egs.distro.on.epicgames.com/Builds/EGLv2/${version}%2B${build}/Linux/EpicGamesLauncher-x86_64.AppImage";
+    hash = "sha256-bizh9dUNFmeOtZrfCer/ueko+uRKO9rpsQ2BDeJJV1s=";
+  };
+
+  appimageContents = appimageTools.extract { inherit pname version src; };
+
+  # Only Epic's binary and the EOS SDK come from the AppImage, all other libraries from nixpkgs.
+  # The EOS SDK can't be packaged separately, as it's only downloadable behind a login.
+  unwrapped = stdenv.mkDerivation {
+    pname = "${pname}-unwrapped";
+    inherit version;
+
+    src = appimageContents;
+
+    nativeBuildInputs = [
+      autoPatchelfHook
+      wrapGAppsHook3
+    ];
+
+    buildInputs = [
+      webkitgtk_4_1
+      libsoup_3
+      gtk3
+      glib
+      glib-networking
+      cairo
+      gdk-pixbuf
+      libx11
+      dbus
+      gsettings-desktop-schemas
+      stdenv.cc.cc.lib
+    ]
+    ++ (with gst_all_1; [
+      gst-plugins-base
+      gst-plugins-good
+      gst-plugins-bad
+      gst-libav
+    ]);
+
+    # Loaded with dlopen
+    runtimeDependencies = [
+      libayatana-appindicator
+      libGL
+      libxi
+    ];
+
+    installPhase = ''
+      runHook preInstall
+
+      install -Dm755 usr/bin/EpicGamesLauncher -t $out/bin
+      install -Dm755 usr/lib/libEOSSDK-Linux-Shipping.so -t $out/lib
+      cp -r usr/lib/epic-games-launcher $out/lib/
+
+      runHook postInstall
+    '';
+  };
+in
+# Windows games run through GE-Proton, which the launcher downloads itself.
+# Its `proton` script is `#!/usr/bin/env python3` and needs the same
+# multiarch FHS as Steam, so use Steam's runtime env like `heroic` does.
+steam.buildRuntimeEnv {
+  inherit pname version;
+
+  extraPkgs = pkgs: [ pkgs.python3 ];
+
+  extraEnv.EGL_DISABLE_SELF_UPDATE = "1";
+
+  runScript = "${unwrapped}/bin/EpicGamesLauncher";
+
+  privateTmp = false;
+
+  extraInstallCommands = ''
+    install -Dm444 ${appimageContents}/usr/share/applications/epic-games-launcher.desktop \
+      -t $out/share/applications
+    substituteInPlace $out/share/applications/epic-games-launcher.desktop \
+      --replace-fail 'Exec=EpicGamesLauncher' 'Exec=epic-games-launcher'
+
+    for size in 32x32 128x128 256x256@2; do
+      install -Dm444 ${appimageContents}/usr/share/icons/hicolor/$size/apps/EpicGamesLauncher.png \
+        -t $out/share/icons/hicolor/$size/apps
+    done
+  '';
+
+  passthru = {
+    inherit src unwrapped;
+    updateScript = ./update.sh;
+  };
+
+  meta = {
+    description = "Desktop client for the Epic Games Store";
+    homepage = "https://launcher.epicgames.com/";
+    license = lib.licenses.unfree;
+    maintainers = with lib.maintainers; [ no-mood ];
+    mainProgram = "epic-games-launcher";
+    platforms = [ "x86_64-linux" ];
+    sourceProvenance = with lib.sourceTypes; [ binaryNativeCode ];
+  };
+}
--- /dev/null
+++ b/pkgs/by-name/ep/epic-games-launcher/update.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env nix-shell
+#!nix-shell -i bash -p curl common-updater-scripts
+
+set -euo pipefail
+
+# The public download link always points to the latest build and redirects
+# to a versioned URL like .../Builds/EGLv2/<version>%2B<build>/Linux/...
+location=$(curl -sI https://launcher-public-service-prod06.ol.epicgames.com/launcher/api/installer/download/EpicGamesLauncher-x86_64.AppImage \
+  | grep -i '^location:' | tr -d '\r')
+
+if [[ ! $location =~ /Builds/EGLv2/([^/]+)%2B([^/]+)/Linux/ ]]; then
+  echo "unexpected redirect: $location" >&2
+  exit 1
+fi
+version=${BASH_REMATCH[1]}
+build=${BASH_REMATCH[2]}
+
+current=$(nix-instantiate --eval --raw -A epic-games-launcher.version)
+if [[ $version == "$current" ]]; then
+  echo "epic-games-launcher is already up to date ($version)"
+  exit 0
+fi
+
+file=$(dirname "${BASH_SOURCE[0]}")/package.nix
+sed -i "s/build = \"[^\"]*\";/build = \"$build\";/" "$file"
+update-source-version epic-games-launcher "$version"
